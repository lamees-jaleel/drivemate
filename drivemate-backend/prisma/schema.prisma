generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                    Int                   @id @default(autoincrement())
  fullName              String                @db.VarChar(80)
  phone                 String                @unique @db.VarChar(20)
  email                 String                @unique @db.VarChar(150)
  address               String                @db.VarChar(255)
  passwordHash          String                @db.VarChar(255)
  role                  Role                  @default(VEHICLE_OWNER)
  accountStatus         AccountStatus         @default(ACTIVE)
  termsAccepted         Boolean               @default(false)
  termsAcceptedAt       DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  diagnosticAssignments DiagnosticRequest[]   @relation("DiagnosticExpertRequests")
  professionalReviews   ProfessionalProfile[] @relation("ProfessionalProfileReviewer")
  professionalProfile   ProfessionalProfile?  @relation("ProfessionalProfileOwner")
  recoverySessions      RecoverySession[]
  roadsideRequests      RoadsideRequest[]     @relation("ResponderRequests")
  reviewedDocuments     VehicleDocument[]     @relation("ReviewedDocuments")
  vehicles              Vehicle[]
  ownerRenewalRequests  DocumentRenewalRequest[] @relation("OwnerRenewalRequests")
  expertRenewalRequests DocumentRenewalRequest[] @relation("ExpertRenewalRequests")

  @@map("users")
}

model ProfessionalProfile {
  id                       Int                @id @default(autoincrement())
  userId                   Int                @unique
  qualification            String             @db.VarChar(100)
  specialization           String             @db.VarChar(120)
  yearsOfExperience        Int
  organizationName         String             @db.VarChar(150)
  certificateNumber        String             @db.VarChar(100)
  serviceLocation          String             @db.VarChar(150)
  verificationDocumentPath String             @db.VarChar(500)
  verificationStatus       VerificationStatus @default(PENDING)
  verificationNote         String?            @db.VarChar(500)
  reviewedById             Int?
  reviewedAt               DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  reviewedBy               User?              @relation("ProfessionalProfileReviewer", fields: [reviewedById], references: [id])
  user                     User               @relation("ProfessionalProfileOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@index([certificateNumber])
  @@index([reviewedById], map: "professional_profiles_reviewedById_fkey")
  @@map("professional_profiles")
}

model Vehicle {
  id                 Int                 @id @default(autoincrement())
  ownerId            Int
  registrationNumber String              @unique @db.VarChar(20)
  make               String              @db.VarChar(80)
  model              String              @db.VarChar(80)
  variant            String?             @db.VarChar(80)
  manufacturingYear  Int
  fuelType           FuelType
  transmission       TransmissionType?
  color              String?             @db.VarChar(50)
  vin                String?             @unique @db.VarChar(50)
  engineNumber       String?             @unique @db.VarChar(50)
  odometerKm         Int                 @default(0)
  purchaseDate       DateTime?           @db.Date
  ownershipType      OwnershipType       @default(OWNED)
  status             VehicleStatus       @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  vehicleImagePath   String?             @db.VarChar(500)
  vehicleType        VehicleType         @default(CAR)
  diagnosticRequests DiagnosticRequest[]
  expenses           Expense[]
  maintenanceRecords MaintenanceRecord[]
  roadsideRequests   RoadsideRequest[]
  documents          VehicleDocument[]
  documentRenewals   DocumentRenewalRequest[]
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([make, model])
  @@map("vehicles")
}

model MaintenanceRecord {
  id                    Int             @id @default(autoincrement())
  vehicleId             Int
  maintenanceType       MaintenanceType
  title                 String          @db.VarChar(120)
  serviceDate           DateTime        @db.Date
  odometerKm            Int
  serviceCenter         String?         @db.VarChar(150)
  description           String?         @db.VarChar(1000)
  cost                  Decimal         @default(0.00) @db.Decimal(10, 2)
  nextServiceDate       DateTime?       @db.Date
  nextServiceOdometerKm Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  isDeleted             Boolean         @default(false)
  vehicle               Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([serviceDate])
  @@index([nextServiceDate])
  @@map("maintenance_records")
}

model Expense {
  id          Int             @id @default(autoincrement())
  vehicleId   Int
  category    ExpenseCategory
  title       String          @db.VarChar(120)
  amount      Decimal         @db.Decimal(10, 2)
  expenseDate DateTime        @db.Date
  odometerKm  Int?
  merchant    String?         @db.VarChar(150)
  notes       String?         @db.VarChar(1000)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([expenseDate])
  @@index([category])
  @@index([vehicleId, expenseDate])
  @@map("expenses")
}

model VehicleDocument {
  id                 Int                @id @default(autoincrement())
  vehicleId          Int
  documentType       DocumentType
  title              String             @db.VarChar(150)
  documentNumber     String?            @db.VarChar(120)
  provider           String?            @db.VarChar(150)
  issueDate          DateTime?          @db.Date
  expiryDate         DateTime?          @db.Date
  filePath           String?            @db.VarChar(500)
  originalFileName   String?            @db.VarChar(255)
  mimeType           String?            @db.VarChar(100)
  fileSize           Int?
  notes              String?            @db.VarChar(1000)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  reviewedAt         DateTime?
  reviewedById       Int?
  verificationNote   String?            @db.VarChar(500)
  verificationStatus VerificationStatus @default(PENDING)
  reviewedBy         User?              @relation("ReviewedDocuments", fields: [reviewedById], references: [id])
  vehicle            Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  renewals           DocumentRenewalRequest[] @relation("DocumentRenewal")

  @@index([vehicleId])
  @@index([documentType])
  @@index([expiryDate])
  @@index([vehicleId, expiryDate])
  @@index([reviewedById])
  @@map("vehicle_documents")
}

model DiagnosticRequest {
  id           Int                     @id @default(autoincrement())
  /// *
  ///    * -------------------------------------------------------
  ///    * VEHICLE
  ///    * -------------------------------------------------------
  vehicleId    Int
  /// *
  ///    * -------------------------------------------------------
  ///    * ASSIGNED EXPERT
  ///    * Null while the request is waiting
  ///    * for an expert to accept it.
  ///    * -------------------------------------------------------
  expertId     Int?
  /// *
  ///    * -------------------------------------------------------
  ///    * OWNER'S CONCERN
  ///    * -------------------------------------------------------
  concernType  DiagnosticConcernType
  urgency      DiagnosticUrgency       @default(NORMAL)
  title        String                  @db.VarChar(120)
  symptoms     String                  @db.VarChar(1500)
  odometerKm   Int?
  status       DiagnosticRequestStatus @default(PENDING)
  /// *
  ///    * -------------------------------------------------------
  ///    * WORKFLOW TIMES
  ///    * -------------------------------------------------------
  acceptedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  /// *
  ///    * -------------------------------------------------------
  ///    * TIMESTAMPS
  ///    * -------------------------------------------------------
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  /// *
  ///    * -------------------------------------------------------
  ///    * SERVICE PROVIDER PREFERENCE
  ///    * Set by the owner at booking time.
  ///    * -------------------------------------------------------
  providerType ServiceProviderType     @default(DRIVEMATE_EXPERT)
  /// Free-text name of the preferred shop / dealer (optional)
  shopName     String?                 @db.VarChar(150)
  report       DiagnosticReport?
  expert       User?                   @relation("DiagnosticExpertRequests", fields: [expertId], references: [id])
  vehicle      Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([expertId])
  @@index([status])
  @@index([createdAt])
  @@index([concernType])
  @@map("diagnostic_requests")
}

model DiagnosticReport {
  id                  Int                @id @default(autoincrement())
  /// *
  ///    * -------------------------------------------------------
  ///    * REQUEST
  ///    * -------------------------------------------------------
  requestId           Int                @unique
  /// *
  ///    * -------------------------------------------------------
  ///    * EXPERT ASSESSMENT
  ///    * -------------------------------------------------------
  findings            String             @db.VarChar(2000)
  suspectedCause      String?            @db.VarChar(1500)
  severity            DiagnosticSeverity
  safeToDrive         Boolean
  recommendedAction   String             @db.VarChar(2000)
  estimatedRepairCost Decimal?           @db.Decimal(10, 2)
  followUpRequired    Boolean            @default(false)
  followUpNotes       String?            @db.VarChar(1000)
  /// *
  ///    * -------------------------------------------------------
  ///    * TIMESTAMPS
  ///    * -------------------------------------------------------
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  request             DiagnosticRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([severity])
  @@map("diagnostic_reports")
}

model RoadsideRequest {
  id           Int                   @id @default(autoincrement())
  vehicleId    Int
  ownerId      Int
  issueType    RoadsideIssueType
  description  String                @db.VarChar(1000)
  location     String                @db.VarChar(255)
  contactPhone String                @db.VarChar(20)
  urgency      String                @default("NORMAL") @db.VarChar(20)
  status       RoadsideRequestStatus @default(PENDING)
  responderId  Int?
  acceptedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  responder    User?                 @relation("ResponderRequests", fields: [responderId], references: [id])
  vehicle      Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([responderId])
  @@index([status])
  @@index([createdAt])
  @@map("roadside_requests")
}

model RecoverySession {
  id           String    @id @default(uuid())
  userId       Int
  email        String    @db.VarChar(150)
  otpHash      String    @db.VarChar(255)
  step         String    @default("INITIATED") @db.VarChar(50)
  attempts     Int       @default(0)
  lastResendAt DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_sessions")
}

enum Role {
  VEHICLE_OWNER
  DIAGNOSTIC_EXPERT
  COMPLIANCE_ADVISOR
  ROADSIDE_RESPONDER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  LPG
  ELECTRIC
  HYBRID
  OTHER
}

enum VehicleType {
  CAR
  BIKE
  TRUCK
  VAN
  OTHER
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  AMT
  CVT
  DCT
  OTHER
}

enum OwnershipType {
  OWNED
  FINANCED
  LEASED
}

enum VehicleStatus {
  ACTIVE
  SOLD
  INACTIVE
}

enum MaintenanceType {
  ROUTINE_SERVICE
  OIL_CHANGE
  REPAIR
  TYRE_SERVICE
  BATTERY_SERVICE
  INSPECTION
  OTHER
}

enum ExpenseCategory {
  FUEL
  INSURANCE
  PARKING
  TOLL
  ROAD_TAX
  EMISSION_TEST
  ACCESSORIES
  WASH_CLEANING
  OTHER
}

enum DocumentType {
  REGISTRATION_CERTIFICATE
  INSURANCE
  POLLUTION_CERTIFICATE
  ROAD_TAX
  FITNESS_CERTIFICATE
  WARRANTY
  SERVICE_DOCUMENT
  PURCHASE_INVOICE
  OTHER
}

enum DiagnosticRequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceProviderType {
  /// Official manufacturer-authorised service centre (dealer, brand workshop)
  AUTHORIZED_DEALER
  /// Independent / local workshop, roadside garage, or multi-brand shop
  LOCAL_SHOP
  /// Travelling/on-demand mechanic who comes to the owner's location
  MOBILE_MECHANIC
  /// Any DriveMate-registered Diagnostic Expert (routed through the platform)
  DRIVEMATE_EXPERT
  INSURANCE_PROVIDER
  GOVERNMENT_PORTAL
}

enum DiagnosticConcernType {
  ENGINE
  TRANSMISSION
  BRAKES
  ELECTRICAL
  BATTERY
  TYRES_SUSPENSION
  OVERHEATING
  WARNING_LIGHT
  NOISE_VIBRATION
  FUEL_EFFICIENCY
  OTHER
}

enum DiagnosticUrgency {
  LOW
  NORMAL
  HIGH
}

enum DiagnosticSeverity {
  MINOR
  MODERATE
  MAJOR
  CRITICAL
}

enum RoadsideRequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RoadsideIssueType {
  FLAT_TYRE
  BATTERY_DEAD
  ENGINE_BREAKDOWN
  FUEL_DELIVERY
  TOWING
  LOCKOUT
  OTHER
}
model DocumentRenewalRequest {
  id              Int                   @id @default(autoincrement())
  ownerId         Int
  vehicleId       Int
  documentId      Int
  expertId        Int?                  
  providerType    ServiceProviderType   @default(DRIVEMATE_EXPERT)
  preferredDate   DateTime?             @db.Date
  notes           String?               @db.VarChar(1000)
  status          RenewalRequestStatus  @default(PENDING)
  acceptedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  owner           User                  @relation("OwnerRenewalRequests", fields: [ownerId], references: [id], onDelete: Cascade)
  expert          User?                 @relation("ExpertRenewalRequests", fields: [expertId], references: [id])
  vehicle         Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  document        VehicleDocument       @relation("DocumentRenewal", fields: [documentId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([vehicleId])
  @@index([documentId])
  @@index([expertId])
  @@index([status])
  @@map("document_renewal_requests")
}

enum RenewalRequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED
}
